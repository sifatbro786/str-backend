# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5025

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/str?appName=Cluster0

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=str_token
JWT_COOKIE_EXPIRES_DAYS=7

# ─── Proxy / BFF ──────────────────────────────────────────
# Number of proxy hops in front of Express. 1 behind a single load balancer.
# 2 when the Next.js BFF also forwards (LB → Next route handler → Express).
TRUST_PROXY_HOPS=1

# Shared secret the Next BFF sends as x-internal-key. Optional but recommended
# once the API host is publicly reachable — see PHASE-4-API-GUIDE §7.
INTERNAL_API_KEY=

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── Seed admin (npm run seed:admin) ──────────────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=solaimanislamsifat@gmail.com
SEED_ADMIN_PASSWORD=111111
