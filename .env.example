# Copy to .env and fill in real values. NEVER commit real secrets in this file.
# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5025

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/str?appName=Cluster0

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=str_token
JWT_COOKIE_EXPIRES_DAYS=7

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── Seed admin (used by npm run seed:admin) ──────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@strsltd.com
SEED_ADMIN_PASSWORD=change-me-strong-password
